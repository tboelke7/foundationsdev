---
// Decorative "audit checklist" card used in the guest-audit hero sections.
const touchpoints = ["Signage and wayfinding", "Menus and pricing", "Policies and instructions", "Room materials", "Website and booking pages", "Booking confirmations"];
---
<div class="tp-panel" aria-hidden="true">
  <p class="tp-head"><span>Guest touchpoints</span><span>Checked</span></p>
  {touchpoints.map(t => (
    <p class="tp-row"><span>{t}</span><span class="tp-tick">✓</span></p>
  ))}
  <p class="tp-foot">One project. One invoice.</p>
</div>

<style>
  .tp-panel{background:rgba(13,27,42,.78);backdrop-filter:blur(3px);border:1px solid rgba(212,168,85,.35);border-radius:14px;padding:22px;color:var(--cream)}
  .tp-head,.tp-row{display:flex;justify-content:space-between;gap:12px}
  .tp-head{font-family:var(--mono);font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);padding-bottom:12px;border-bottom:1px solid rgba(212,168,85,.28)}
  .tp-row{padding:11px 0;border-bottom:1px solid rgba(255,255,255,.08);font-size:.95rem}
  .tp-tick{color:var(--gold);font-weight:800}
  .tp-foot{margin-top:14px;font-family:var(--display);font-weight:800}
</style>
