---
import Base from '../layouts/BaseLayout.astro';
import TouchpointPanel from '../components/TouchpointPanel.astro';
import { services, guestAudit as ga, guestAuditHref } from '../siteConfig.js';

const auditHref = guestAuditHref(ga.form.auditValue);
const issues = [
  "Awkward phrasing that reads like direct translation",
  "Mistranslations that keep the words but lose the meaning",
  "Inconsistent tone across touchpoints",
  "Copy that confuses rather than welcomes",
];
const description = "International Guest Experience Audit for hotels, restaurants, and guesthouses in Sri Lanka. We audit the English your guests see and read and deliver corrected, guest-ready copy. One project, one invoice.";
---
<Base path="/" description={description}>
  <!-- BRAND HERO: who Foundations is, before any single offer -->
  <section class="brand-hero">
    <div class="wrap brand-grid">
      <div>
        <p class="label" style="color:var(--gold)">Foundations Business Development</p>
        <h1 style="margin-top:16px">Build the base.<br/>Build the business.</h1>
        <p style="margin-top:20px;max-width:52ch;font-size:1.12rem;opacity:.9">
          We build the foundations businesses grow on: guest experience language audits for Sri Lankan
          hospitality, and owned websites, lead systems, and marketing infrastructure for service businesses.
          You own every account, asset, and login. We set it up; it stays yours.
        </p>
        <div style="margin-top:28px;display:flex;gap:14px;flex-wrap:wrap">
          <a class="btn" href="#audit">Guest Experience Audits</a>
          <a class="btn btn-ghost" style="border-color:var(--gold);color:var(--gold)" href="/services/">Websites &amp; Marketing</a>
        </div>
      </div>
      <div class="brand-visual" aria-hidden="true">
        <div class="bv-site">
          <span class="bv-dot"></span><span class="bv-dot"></span><span class="bv-dot"></span>
          <div class="bv-bar"></div>
          <div class="bv-line w1"></div>
          <div class="bv-line w2"></div>
          <div class="bv-cta"></div>
        </div>
        <span class="bv-chip c1">Guest Language QA</span>
        <span class="bv-chip c2">Speed-to-Lead</span>
        <span class="bv-chip c3">Google Business Profile</span>
        <span class="bv-chip c4">Reviews & Reputation</span>
      </div>
    </div>
    <div class="wrap trust-strip">
      <span>Client-owned assets</span><span>No contracts</span><span>No ad-spend markup</span><span>Human-verified work</span>
    </div>
  </section>

  <!-- HERO: the guest experience audit is the lead offer -->
  <section id="audit" class="audit-lead" style="padding:64px 0 72px;border-top:3px solid var(--gold)">
    <div class="wrap hero">
      <div class="hero-copy">
        <p class="label" style="color:var(--gold)">International Guest Experience Audit · Sri Lanka</p>
        <h2 style="margin-top:14px;font-size:clamp(1.9rem,4.2vw,3rem)">Make sure your guests see and hear what you intend.</h2>
        <p style="margin-top:20px;max-width:52ch;font-size:1.12rem;opacity:.9">
          We audit your guest-facing English, your website, menus, signage, policies, and materials,
          and make sure it communicates clearly, naturally, and at the quality level of your brand.
        </p>
        <p class="support">Human expert. Bilingual verification. Zero guessing.</p>
        <div style="margin-top:28px;display:flex;gap:14px;flex-wrap:wrap">
          <a class="btn" href={auditHref}>Request an Audit</a>
          <a class="btn btn-ghost" style="border-color:var(--gold);color:var(--gold)" href={ga.path}>See how it works</a>
        </div>
        <p style="margin-top:22px;opacity:.7;font-size:.95rem">For hotels, resorts, restaurants, guesthouses, and attractions in Sri Lanka.</p>
      </div>
      <TouchpointPanel />
    </div>
  </section>

  <!-- STATS BAND -->
  <section class="stats" style="padding:0">
    <div class="wrap">
      <div class="statrow">
        <div class="stat">
          <span class="statnum">1</span>
          <span class="statlbl">Project, one invoice.<br/>Audit and corrections together</span>
        </div>
        <div class="stat">
          <span class="statnum">100<span class="pct">%</span></span>
          <span class="statlbl">Of corrections verified<br/>by a human expert</span>
        </div>
        <div class="stat">
          <span class="statnum">5–7</span>
          <span class="statlbl">Business days for a<br/>Quick Guest Language Review</span>
        </div>
        <div class="stat">
          <span class="statnum">0</span>
          <span class="statlbl">Hidden fees. Firm quote<br/>before we start</span>
        </div>
      </div>
    </div>
  </section>

  <!-- THE CHALLENGE -->
  <section>
    <div class="wrap challenge">
      <div>
        <p class="label">The challenge</p>
        <h2 style="margin-top:10px">These aren't grammar problems. They're accountability problems.</h2>
        <p style="margin-top:16px;color:var(--muted)">
          Your international guests encounter English across every touchpoint. Content moves from concept to
          translation to design to print without anyone owning the final checkpoint. No one verifies that the
          meaning is actually right, not just grammatically acceptable.
        </p>
        <p style="margin-top:14px;color:var(--muted)">
          The cheapest moment to catch this is before your guests see it printed or published.
          That's where we come in. <strong style="color:var(--navy)">We own the checkpoint.</strong>
        </p>
      </div>
      <div class="issues">
        {issues.map(i => <p class="issue">{i}</p>)}
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="wrap">
      <p class="label">How we work</p>
      <h2 style="margin-top:10px">Three capabilities, one accountable checkpoint.</h2>
      <div class="grid g3" style="margin-top:36px">
        {ga.capabilities.map((c, i) => (
          <div>
            <span class="stepn">{String(i + 1).padStart(2, "0")}</span>
            <h3 style="font-size:1.2rem;margin-top:12px">{c.title}</h3>
            <p style="margin-top:10px;color:var(--muted)">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES AND PRICING (summary; full detail on the audit page) -->
  <section>
    <div class="wrap">
      <p class="label">Services and pricing</p>
      <h2 style="margin-top:10px">Pick the scope that fits your property.</h2>
      <div class="grid g3" style="margin-top:36px;align-items:stretch">
        {ga.tiers.map(t => (
          <a class={"card tier" + (t.featured ? " feat" : "")} href={`${ga.path}#pricing`}>
            <p class="label">{t.name}</p>
            <p class="tier-price">{t.price}</p>
            <p class="tier-per">{t.per}</p>
            <p style="margin-top:12px;color:var(--muted);font-size:.94rem;flex:1">{t.fit}</p>
            <p class="label" style="margin-top:16px">See what's included →</p>
          </a>
        ))}
      </div>
      <p style="margin-top:24px;text-align:center;color:var(--muted)">
        <strong style="color:var(--navy)">One project, one invoice.</strong> We give a firm quote before we start, and you own the corrected materials.
      </p>
    </div>
  </section>

  <!-- PARTNER PROGRAM -->
  <section style="background:var(--navy);color:var(--cream)">
    <div class="wrap partner">
      <div>
        <p class="label" style="color:var(--gold)">Partner Program · White label</p>
        <h2 style="margin-top:10px">For printers, sign companies, and hotel suppliers.</h2>
        <p style="margin-top:16px;max-width:56ch;opacity:.9">
          Add professional English QA to your client delivery without hiring editorial staff.
          You keep the relationship, we ensure the language quality.
        </p>
      </div>
      <div class="partner-side">
        <ul class="ticks">
          <li>Partner Plan: $150 per month plus one-time $150 onboarding, up to 50 item reviews</li>
          <li>Stay a year and the onboarding fee comes back: your 13th month is on us</li>
          <li>Busy month? Add 20 more reviews for $50</li>
          <li>Send artwork by WhatsApp, same-day turnaround on simple items</li>
          <li>Charge it through to your customers or bundle it as your differentiator</li>
          <li>Costs less than one reprint a month</li>
        </ul>
        <a class="btn" style="margin-top:22px" href={`${ga.path}#partners`}>Explore Our Partner Program</a>
      </div>
    </div>
  </section>

  <!-- CONTRACTOR WEB PRESENCE (secondary line of business) -->
  <section style="background:#fff;border-bottom:1px solid var(--line)">
    <div class="wrap">
      <p class="label">Also from Foundations</p>
      <h2 style="margin-top:10px">Websites, marketing, and lead systems.</h2>
      <p style="margin-top:12px;max-width:60ch;color:var(--muted)">
        Fast, owned websites, Google search visibility, lead follow-up, and reviews, for trades, restaurants, and
        hospitality businesses in the U.S. and Sri Lanka. You own everything we build.
      </p>
      <div class="svc-mini">
        {services.map(s => (
          <a href={`/services/${s.slug}/`}>
            <span class="svc-mini-t">{s.title}</span>
            <span class="svc-mini-d">{s.tease}</span>
          </a>
        ))}
      </div>
      <div style="margin-top:26px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-ghost" href="/services/">Browse Our Services</a>
        <a class="btn btn-ghost" href="/contact/">Get a free Report Card</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--navy);color:var(--cream);text-align:center">
    <div class="wrap">
      <h2 style="max-width:22ch;margin-inline:auto">Ready to make sure your guests see and hear what you intend?</h2>
      <a class="btn" style="margin-top:28px" href={auditHref}>Request an Audit</a>
    </div>
  </section>

  <style>
    .brand-hero{background:linear-gradient(180deg,var(--navy) 0%,#122438 100%);color:var(--cream);padding:88px 0 0}
    .brand-grid{display:grid;gap:52px;align-items:center;padding-bottom:64px}
    @media(min-width:940px){.brand-grid{grid-template-columns:1.15fr .85fr}}
    .brand-visual{position:relative;min-height:280px;display:none}
    @media(min-width:940px){.brand-visual{display:block}}
    .bv-site{position:absolute;inset:12% 8% 18% 4%;background:rgba(245,240,232,.06);border:1px solid rgba(212,168,85,.35);border-radius:14px;padding:18px}
    .bv-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:rgba(212,168,85,.5);margin-right:6px}
    .bv-bar{margin-top:16px;height:30px;width:62%;border-radius:6px;background:rgba(212,168,85,.85)}
    .bv-line{height:12px;border-radius:6px;background:rgba(245,240,232,.22);margin-top:12px}
    .bv-line.w1{width:84%}
    .bv-line.w2{width:70%}
    .bv-cta{margin-top:18px;height:34px;width:38%;border-radius:8px;background:var(--gold)}
    .bv-chip{position:absolute;font-family:var(--mono);font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;background:var(--navy);border:1px solid var(--gold);color:var(--gold);border-radius:20px;padding:8px 14px;white-space:nowrap;box-shadow:0 12px 30px rgba(0,0,0,.35)}
    .bv-chip.c1{top:2%;right:0}
    .bv-chip.c2{top:34%;right:-2%}
    .bv-chip.c3{bottom:24%;left:-2%}
    .bv-chip.c4{bottom:4%;right:12%}
    .trust-strip{display:flex;gap:14px 34px;flex-wrap:wrap;justify-content:center;padding-top:20px;padding-bottom:20px;border-top:1px solid rgba(212,168,85,.25)}
    .trust-strip span{font-family:var(--mono);font-size:.82rem;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);opacity:.85}

    .audit-lead{position:relative;background:var(--navy);color:var(--cream);overflow:hidden}
    .audit-lead::before{content:"";position:absolute;inset:0;background:url('/images/audit-lead.webp') calc(100% + 130px) center/contain no-repeat}
    .audit-lead::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,var(--navy) 0%,var(--navy) 30%,rgba(13,27,42,.82) 52%,rgba(13,27,42,.2) 100%)}
    .audit-lead .wrap{position:relative;z-index:1}
    @media(max-width:899px){.audit-lead::after{background:rgba(13,27,42,.88)}}

    .hero{display:grid;gap:44px;align-items:center}
    @media(min-width:900px){.hero{grid-template-columns:1.2fr .8fr}}
    .support{margin-top:18px;font-family:var(--mono);font-size:.92rem;letter-spacing:.08em;text-transform:uppercase;color:var(--gold)}

    .stats{background:var(--cream);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .statrow{display:grid;grid-template-columns:repeat(2,1fr);gap:0}
    @media(min-width:760px){.statrow{grid-template-columns:repeat(4,1fr)}}
    .stat{padding:34px 24px;text-align:center;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
    @media(min-width:760px){.stat{border-bottom:none}.stat:last-child{border-right:none}}
    .stat:nth-child(2n){border-right:none}
    @media(min-width:760px){.stat:nth-child(2n){border-right:1px solid var(--line)}}
    .statnum{display:block;font-family:var(--display);font-weight:800;font-size:2.8rem;line-height:1;color:var(--navy);letter-spacing:-.02em}
    .statnum .pct{color:var(--brass);font-size:1.6rem;vertical-align:super}
    .statlbl{display:block;margin-top:12px;font-size:.9rem;color:var(--muted);line-height:1.45}

    .challenge{display:grid;gap:36px;align-items:center}
    @media(min-width:900px){.challenge{grid-template-columns:1.1fr .9fr}}
    .issues{display:flex;flex-direction:column;gap:12px}
    .issue{padding:14px 16px;border-left:3px solid var(--brass);background:#fff;border-radius:0 8px 8px 0;color:var(--navy)}

    .stepn{font-family:var(--display);font-weight:800;font-size:2.4rem;color:var(--gold);-webkit-text-stroke:1px var(--brass)}

    .tier{display:flex;flex-direction:column;transition:.2s}
    .tier:hover{border-color:var(--gold)}
    .tier.feat{border:2px solid var(--gold);box-shadow:0 20px 50px rgba(13,27,42,.12)}
    .tier-price{font-family:var(--display);font-weight:800;font-size:1.8rem;margin-top:10px;line-height:1.1;color:var(--navy)}
    .tier-per{font-size:.88rem;color:var(--muted)}

    .partner{display:grid;gap:36px;align-items:center}
    @media(min-width:900px){.partner{grid-template-columns:1.1fr .9fr}}
    .partner-side{padding:26px;border-radius:14px;border:1px solid rgba(212,168,85,.3)}
    .ticks{list-style:none;display:flex;flex-direction:column;gap:10px}
    .ticks li{padding-left:26px;position:relative}
    .ticks li::before{content:"✓";position:absolute;left:0;color:var(--gold);font-weight:800}

    .svc-mini{display:grid;gap:0 28px;margin-top:28px;border-top:1px solid var(--line)}
    @media(min-width:760px){.svc-mini{grid-template-columns:repeat(2,1fr)}}
    @media(min-width:1000px){.svc-mini{grid-template-columns:repeat(4,1fr)}}
    .svc-mini a{display:flex;flex-direction:column;padding:14px 0;border-bottom:1px solid var(--line)}
    .svc-mini-t{font-weight:700;color:var(--navy)}
    .svc-mini a:hover .svc-mini-t{color:var(--brass)}
    .svc-mini-d{font-size:.84rem;color:var(--muted)}
  </style>
</Base>
