---
import Base from '../layouts/BaseLayout.astro';
import { guestAudit, guestAuditHref } from '../siteConfig.js';

const team = [
  { initials: "TB", name: "Troy Boelke", role: "Founder · Strategy & guest-facing marketing",
    body: "Over a decade in business development and marketing. Troy reads your property the way your target guest does, because he is one, and turns the findings into changes that affect bookings, not just grammar." },
  { initials: "HB", name: "Heather Boelke", role: "English QA & on-site audit lead",
    body: "A University of Wisconsin-La Crosse graduate, Heather taught English and was a state Teacher of the Year finalist before stepping away to raise her young children. She reads every menu line, every room card, and every guest message, and catches what a quick skim never will." },
  { initials: "VB", name: "Dr. Vindya Boelke", role: "Bilingual meaning verification",
    body: "Born and raised in Sri Lanka, now a practising physician in the United States. Vindya makes sure nothing is lost in translation in either direction: the warmth of Sri Lankan hospitality stays intact, and the English meets the standard a physician holds for every written word." },
];
---
<Base title="About" description="Foundations is a family team helping Sri Lankan hospitality businesses make sure international guests see and hear what they intend, built on over a decade of marketing for trades and service businesses." path="/about/">
  <section style="background:var(--navy);color:var(--cream);padding:56px 0">
    <div class="wrap" style="max-width:760px">
      <p class="label">About</p>
      <h1 style="margin-top:12px">Great work deserves to be understood.</h1>
      <p style="margin-top:18px;max-width:56ch;font-size:1.15rem;opacity:.9">
        Foundations started with trades businesses that do excellent work but can't be found online.
        Then, traveling across Sri Lanka, we kept seeing the same gap in a different form.
      </p>
    </div>
  </section>

  <!-- WHY THE AUDIT -->
  <section>
    <div class="wrap why">
      <div>
        <p class="label">Why we built the audit</p>
        <h2 style="margin-top:10px">We kept seeing it, far too often.</h2>
      </div>
      <div class="why-body">
        <p>
          Throughout our extensive travels across the island, we stayed in guesthouses with warm, generous
          hosts, hotels in settings that stop you in your tracks, and restaurants worth crossing the country for.
          And again and again, the English on the menu, the signs, the website, or the booking confirmation
          didn't match the experience behind it.
        </p>
        <p>
          It was never a matter of not caring. Content moves from concept to translation to design to print,
          and no one owns the final checkpoint. Nobody verifies that the meaning is actually right, not just
          grammatically acceptable.
        </p>
        <p>
          International guests don't see the care behind a property. They see the words. So we built a service
          that owns that checkpoint, with a team that understands both sides of the sentence.
        </p>
        <a class="btn" style="margin-top:8px" href={guestAudit.path}>See the Guest Experience Audit</a>
      </div>
    </div>
  </section>

  <!-- WHO IS INVOLVED -->
  <section style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
    <div class="wrap">
      <p class="label">Who's involved</p>
      <h2 style="margin-top:10px;max-width:28ch">A family team, one standard: would a guest from London or Melbourne read this and feel at home?</h2>
      <div class="grid g3" style="margin-top:36px">
        {team.map(t => (
          <div class="card member">
            <span class="initials" aria-hidden="true">{t.initials}</span>
            <h3 style="font-size:1.2rem;margin-top:16px">{t.name}</h3>
            <p class="member-role">{t.role}</p>
            <p style="margin-top:12px;color:var(--muted)">{t.body}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:28px;color:var(--muted);max-width:62ch">
        Between us, the team includes native fluency in English and Sri Lankan languages. Every correction
        is verified by a human expert before it reaches you.
      </p>
    </div>
  </section>

  <!-- WHERE IT STARTED -->
  <section>
    <div class="wrap about-grid">
      <div class="about-photo">
        <img src="/images/troy.webp" alt="Troy Boelke, founder of Foundations Business Development"
             width="520" height="600" onerror="this.classList.add('ph')" />
      </div>
      <div class="about-body">
        <p class="label">Where Foundations started</p>
        <h2 style="margin-top:8px">Troy Boelke, founder</h2>
        <p style="margin-top:18px">
          Troy brings over a decade in the kitchen and bath remodeling business and a business degree
          from the University of Minnesota. He's worked in most positions across the field — so he
          understands these businesses from the inside, not from a marketing textbook.
        </p>
        <p style="margin-top:16px;color:var(--muted)">
          For five years, Troy served as Director of Marketing for a national kitchen and bath franchise
          group, where he helped new and existing franchisees start and grow their businesses. That work
          meant combining every area of the field — operations, sales, branding, and lead generation —
          into marketing programs that actually moved the needle for real trades businesses.
        </p>
        <p style="margin-top:16px;color:var(--muted)">
          Later, selling cabinets to dealers across the country gave him the bigger picture: just how
          many genuinely great businesses and people are out there doing excellent work — and how many
          of them simply can't be found online. That's the gap Foundations closes.
        </p>
        <p style="margin-top:16px">
          The same instinct drives the Guest Experience Audit: great work should reach the people
          looking for it, in words they understand.
        </p>
      </div>
    </div>
  </section>

  <section style="background:var(--navy);color:var(--cream);text-align:center">
    <div class="wrap" style="max-width:760px">
      <h2 style="max-width:22ch;margin-inline:auto">Ready to make sure your guests see and hear what you intend?</h2>
      <div style="margin-top:26px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn" href={guestAuditHref(guestAudit.form.auditValue)}>Request an Audit</a>
        <a class="btn btn-ghost" style="border-color:var(--gold);color:var(--gold)" href="/contact/">Trades business? Get a free Report Card</a>
      </div>
    </div>
  </section>

  <style>
    .why{display:grid;gap:28px;align-items:start}
    @media(min-width:860px){.why{grid-template-columns:.8fr 1.2fr;gap:48px}}
    .why-body{display:flex;flex-direction:column;gap:16px;font-size:1.05rem}
    .why-body p:not(:first-child){color:var(--muted)}
    .why-body .btn{align-self:flex-start}
    .member{display:flex;flex-direction:column}
    .initials{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;background:var(--navy);color:var(--gold);font-family:var(--display);font-weight:800;font-size:1.1rem}
    .member-role{margin-top:4px;font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--brass)}
    .about-grid{display:grid;gap:44px;align-items:start}
    @media(min-width:820px){.about-grid{grid-template-columns:.8fr 1.2fr}}
    .about-photo img{width:100%;height:auto;border-radius:14px;border:1px solid var(--line);box-shadow:0 20px 50px rgba(13,27,42,.12);aspect-ratio:13/15;object-fit:cover;display:block}
    .about-photo img.ph{background:linear-gradient(135deg,var(--cream),#fff);min-height:420px}
  </style>
</Base>
